# ============================================================================
# 所有 target 共用的叠加配置（只编 fw4 / nftables 固件）
#
# 由 scripts/lib.sh 的 load_config() 在 <target>.config 之后追加，再交给
# make defconfig 解析；kconfig 里后出现的赋值覆盖先出现的。
#
# 2026-10-26 起不再编 fw3（iptables）固件：lede 上游 b60c8143（2026-10-03）
# 已把路由器默认包换成 firewall4，原先留空的 fw3.config 从那时起编出的是
# fw4 + iptables 的混合体。本文件原名 fw4.config。
#
# lede 的 DEFAULT_PACKAGES.router 仍带着 iptables、ipset、turboacc 等，
# 下面逐项关掉；fw3 的 firewall 与 firewall4 是硬冲突，也在这里成对处理。
# ============================================================================

CONFIG_PACKAGE_firewall4=y
# fw3 与 fw4 是硬冲突（firewall/Makefile: CONFLICTS:=firewall4），必须成对处理
# CONFIG_PACKAGE_firewall is not set

# dnsmasq 改用 nftset。该选项默认 y，不关会经 kmod-ipt-ipset -> kmod-ipt-core
# 把整个 xtables 内核层拉回镜像
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set

# turboacc 的 FastPath Engine 是非 optional 的 choice，本 target 上三个可选引擎
# （FLOW_OFFLOADING / FAST_CLASSIFIER / SHORTCUT_FE_CM）都会经 kmod-ipt-core
# 拖回 xtables，而 NO_FASTPATH 的 prompt 被 TARGET_qualcommax 等条件挡住不可选。
# fw4 原生 flowtable 已覆盖其全部实际功能，故整包移除。
# CONFIG_PACKAGE_luci-app-turboacc is not set

# 关闭 fw3 栈及 DEFAULT_PACKAGES.router 的尾巴
# 注意：kmod-nf-nathelper(-extra) 不在此列——它们是 conntrack ALG 助手
#       （FTP/SIP/PPTP/IRC/TFTP），只依赖 kmod-nf-nat，fw4 下照常可用
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_ipset is not set
# CONFIG_PACKAGE_iptables-mod-tproxy is not set
# CONFIG_PACKAGE_iptables-mod-extra is not set
# CONFIG_PACKAGE_kmod-ipt-raw is not set
# CONFIG_PACKAGE_kmod-ipt-nat6 is not set

# aether-proxy（feeds.conf 的 aetherproxy）：依赖 firewall4（DEPENDS +firewall4）。
# 随固件装上但默认不启用（/etc/config/aetherproxy 的 enabled=0），与 ssr-plus 并存；
# 依赖（kmod-nft-tproxy/socket、ucode 模块、rpcd-mod-ucode 等）由 kconfig 自动带入。
# 装上之后由它自己的发布通道更新（LuCI「更新」页），固件只提供首次安装的版本。
CONFIG_PACKAGE_aether-proxy=y
# aether-proxy 1.0.0 起声明虚拟依赖 +dns-engine。1.0.0 起 aether-dns 是它的默认提供者，
# 固件同时装上两者：运行时优先 /usr/bin/aether-dns，没有才回退 chinadns-ng。
# aether-dns 来自 feeds.conf 的 aetherdns feed；二进制在构建时从 DNS Release 取出（configs/aetherdns.conf）。
CONFIG_PACKAGE_aether-dns=y
# chinadns-ng 保留为备用提供者（也覆盖不装 aether-dns 的旧配置）。
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_luci-app-aether-proxy=y
CONFIG_PACKAGE_luci-i18n-aether-proxy-zh-cn=y
